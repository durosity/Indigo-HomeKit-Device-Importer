<Devices>
	<Device type="custom" id="hkPairing">
		<Name>HomeKit Accessory Connection</Name>
		<ConfigUI>
			<Field id="info" type="label">
				<Label>This device shows the connection to one paired HomeKit accessory or bridge. Pair and unpair from Plugins > HomeKit Device Importer > Open Pairing Page.</Label>
			</Field>
		</ConfigUI>
		<States>
			<State id="status">
				<ValueType>String</ValueType>
				<TriggerLabel>Connection Status</TriggerLabel>
				<ControlPageLabel>Connection Status</ControlPageLabel>
			</State>
			<State id="reason">
				<ValueType>String</ValueType>
				<TriggerLabel>Offline Reason</TriggerLabel>
				<ControlPageLabel>Offline Reason</ControlPageLabel>
			</State>
			<State id="deviceId">
				<ValueType>String</ValueType>
				<TriggerLabel>HomeKit Device ID</TriggerLabel>
				<ControlPageLabel>HomeKit Device ID</ControlPageLabel>
			</State>
			<State id="transport">
				<ValueType>String</ValueType>
				<TriggerLabel>Connection Type</TriggerLabel>
				<ControlPageLabel>Connection Type</ControlPageLabel>
			</State>
			<State id="address">
				<ValueType>String</ValueType>
				<TriggerLabel>Network Address</TriggerLabel>
				<ControlPageLabel>Network Address</ControlPageLabel>
			</State>
			<State id="category">
				<ValueType>String</ValueType>
				<TriggerLabel>Category</TriggerLabel>
				<ControlPageLabel>Category</ControlPageLabel>
			</State>
			<State id="manufacturer">
				<ValueType>String</ValueType>
				<TriggerLabel>Manufacturer</TriggerLabel>
				<ControlPageLabel>Manufacturer</ControlPageLabel>
			</State>
			<State id="model">
				<ValueType>String</ValueType>
				<TriggerLabel>Model</TriggerLabel>
				<ControlPageLabel>Model</ControlPageLabel>
			</State>
			<State id="firmware">
				<ValueType>String</ValueType>
				<TriggerLabel>Firmware</TriggerLabel>
				<ControlPageLabel>Firmware</ControlPageLabel>
			</State>
			<State id="accessoryCount">
				<ValueType>Number</ValueType>
				<TriggerLabel>Accessory Count</TriggerLabel>
				<ControlPageLabel>Accessory Count</ControlPageLabel>
			</State>
			<State id="lastSeen">
				<ValueType>String</ValueType>
				<TriggerLabel>Last Seen</TriggerLabel>
				<ControlPageLabel>Last Seen</ControlPageLabel>
			</State>
		</States>
		<UiDisplayStateId>status</UiDisplayStateId>
	</Device>

